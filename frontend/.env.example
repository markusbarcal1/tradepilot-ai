# Local development URL; set the HTTPS Render URL in Vercel before building.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
# Public browser key only. Publishable key takes precedence if both are set.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key is also supported; configure one of these two keys.
VITE_SUPABASE_ANON_KEY=
# All VITE_ values are bundled into the browser. Never use a service-role key.
