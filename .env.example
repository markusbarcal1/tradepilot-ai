# Runtime environment: development, test, or production.
ENVIRONMENT=development

# SQLite is for disposable/local development only; production uses authoritative
# Supabase PostgreSQL. The former production SQLite database is archived.
# Relative SQLite paths resolve from the repository root.
DATABASE_URL=sqlite:///backend/app/paper_trading.db
# Managed PostgreSQL (server-side only; percent-encode credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# For managed connections append ?sslmode=verify-full&sslrootcert=PATH_TO_PROVIDER_CA
# Offline migration target is separate from the active application URL.
# MIGRATION_TARGET_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# PostgreSQL only; each backend worker has its own pool (up to 7 connections).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Comma-separated explicit origins (a JSON string array is also accepted).
# On Render replace these with the exact HTTPS frontend origin(s), no paths.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-side scanner concurrency ceiling (1-16).
SCANNER_MAX_WORKERS=8
# Optional scanner audit logging; keep disabled for normal beta traffic.
SCANNER_AUDIT=false

# CRITICAL, ERROR, WARNING, INFO, or DEBUG.
LOG_LEVEL=INFO

# Supabase Auth JWT verification. Optional in development/test; all three are
# required in production. Use the project Auth issuer and asymmetric JWKS URL.
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_AUDIENCE=
SUPABASE_JWKS_URL=

# Outlook structured evidence. Backend only; no real keys in this template.
OUTLOOK_SEC_ENABLED=true
# Bounded primary-source interpretation; disable to retain metadata-only SEC behavior.
OUTLOOK_SEC_DOCUMENTS_ENABLED=true
OUTLOOK_SEC_MAX_DOCUMENT_FILINGS=2
OUTLOOK_FRED_ENABLED=true
OUTLOOK_MARKET_ENABLED=true
# Required to request SEC data: application name and a real operator contact email.
OUTLOOK_SEC_USER_AGENT=
FRED_API_KEY=
OUTLOOK_CIK_CACHE_TTL=86400
OUTLOOK_SEC_CACHE_TTL=3600
OUTLOOK_ECONOMIC_CACHE_TTL=21600
OUTLOOK_MARKET_CACHE_TTL=900
OUTLOOK_FAILURE_CACHE_TTL=60
OUTLOOK_HTTP_TIMEOUT=5
OUTLOOK_HTTP_ATTEMPTS=1
OUTLOOK_SEC_REQUEST_INTERVAL=1
